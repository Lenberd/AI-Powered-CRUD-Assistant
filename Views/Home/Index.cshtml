@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Task Assistant</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="mark" aria-hidden="true">AI</span>
                <div>
                    <div class="brand-title">Task Assistant</div>
                    <div class="brand-sub">Gemini · function calling</div>
                </div>
            </div>

            <button id="newChatBtn" type="button" class="new-chat-btn">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                New conversation
            </button>

            <nav class="side-section">
                <div class="side-label">Workspace</div>
                <a class="side-item active" href="#chatStage">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5.5A1.5 1.5 0 0 1 4.5 4h11A1.5 1.5 0 0 1 17 5.5v6A1.5 1.5 0 0 1 15.5 13H9l-3.5 3v-3H4.5A1.5 1.5 0 0 1 3 11.5v-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                    Assistant
                </a>
                <a class="side-item" href="#tasksPanel">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 6h12M4 10h12M4 14h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Tasks
                    <span id="taskCount" class="badge"></span>
                </a>
            </nav>

            <div class="side-section audit-section">
                <div class="side-label">
                    Audit log
                    <span class="side-label-hint">every proposed call</span>
                </div>
                <div id="auditLog" class="audit-log">
                    <div class="audit-empty">Nothing proposed yet this session.</div>
                </div>
            </div>

            <div class="sidebar-bottom">
                <div class="live-status">
                    <span class="live-dot"></span>
                    <span>Backend validates every call before it runs</span>
                </div>
            </div>
        </aside>

        <main class="chat-column" id="chatStage">
            <header class="main-topbar">
                <span class="model-pill">gemini-3.6-flash</span>
                <button id="refreshBtn" class="btn btn-outline-secondary btn-sm" type="button">
                    <span aria-hidden="true">&#8635;</span> Refresh tasks
                </button>
            </header>

            <div class="chat-stage">
                <div id="welcomePanel" class="welcome-panel">
                    <span class="welcome-mark" aria-hidden="true">AI</span>
                    <h1 class="welcome-title">Tell it what to do</h1>
                    <p class="welcome-sub">Create, update, complete, or delete tasks by typing naturally - a real tool-calling AI decides the action, your backend validates and executes it.</p>

                    <div class="suggestion-grid">
                        <button type="button" class="suggestion-card" data-prompt="Add a task called 'Finish report' due next Friday">
                            <span class="suggestion-icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20" fill="none"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                            </span>
                            <strong>Create a task</strong>
                            <span>"Add a task called 'Finish report' due next Friday"</span>
                        </button>
                        <button type="button" class="suggestion-card" data-prompt="Show me everything that's not done yet">
                            <span class="suggestion-icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20" fill="none"><path d="M4 6h12M4 10h12M4 14h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                            </span>
                            <strong>List tasks</strong>
                            <span>"Show me everything that's not done yet"</span>
                        </button>
                        <button type="button" class="suggestion-card" data-prompt="Mark task 1 as done">
                            <span class="suggestion-icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20" fill="none"><path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </span>
                            <strong>Update a task</strong>
                            <span>"Mark task 1 as done"</span>
                        </button>
                    </div>
                </div>

                <div id="chatLog" class="chat-log" aria-live="polite"></div>

                <div id="confirmBar" class="confirm-bar d-none">
                    <span id="confirmText"></span>
                    <div class="confirm-actions">
                        <button id="confirmYes" type="button" class="btn btn-danger btn-sm">Yes, delete</button>
                        <button id="confirmNo" type="button" class="btn btn-secondary btn-sm">Cancel</button>
                    </div>
                </div>

                <form id="chatForm" class="chat-form" autocomplete="off">
                    <input id="chatInput" type="text" class="form-control" placeholder="e.g. Add a task called 'Finish report' due next Friday" required />
                    <button type="submit" class="btn btn-primary btn-send">
                        Send
                        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10l14-6-6 14-2-6-6-2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                    </button>
                </form>
                <div class="chat-examples">
                    <button type="button" class="example-chip">What's the capital of France?</button>
                    <button type="button" class="example-chip">Delete the report task</button>
                </div>
            </div>
        </main>

        <aside class="panel tasks-panel" id="tasksPanel">
            <div class="panel-header">Tasks</div>

            <div class="task-table-wrap">
                <table class="task-table">
                    <thead>
                        <tr>
                            <th class="col-done"></th>
                            <th class="col-id">ID</th>
                            <th>Title</th>
                            <th class="col-due">Due</th>
                        </tr>
                    </thead>
                    <tbody id="taskTableBody"></tbody>
                </table>
            </div>

            <div class="pagination">
                <button id="prevPageBtn" type="button" class="btn btn-outline-secondary btn-sm" disabled>&larr; Prev</button>
                <span id="pageLabel" class="page-label">Page 1 of 1</span>
                <button id="nextPageBtn" type="button" class="btn btn-outline-secondary btn-sm" disabled>Next &rarr;</button>
            </div>
        </aside>
    </div>

    <script src="~/js/assistant.js" asp-append-version="true"></script>
</body>
</html>
